{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "GameScript",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
    				"name": "constant.numeric.gamescript",
    				"match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?\\b"
				},
				{
					"name": "keyword.control.gamescript",
					"match": "\\b(if|while|for|return|inherit)\\b"
				},
				{
					"match": "\\b(def)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
					"captures": {
						"1": {
							"name": "keyword"
						},
						"2": {
							"name": "entity.name.function.gamescript"
						},
						"3": {
							"name": "punctuation.section.parens.begin.gamescript"
						}
					}
				},
				{
      				"name": "keyword.directive.annotation.gamescript",
      				"match": "@\\w+"
    			},
				{
					"match": "\\b(script_name)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
					"captures": {
						"1": {
							"name": "keyword"
							},
						"2": {
							"name": "entity.name.type.gamescript"
					}
					}
				},
				{
					"name":"keyword",
					"match": "\\b(def|true|false|none|script_name)\\b"
				},
				{
					"name":"entity.name.class",
					"match":"\\b(Object|MainScript|Integer|Float|String|Boolean|Class)\\b"
				},
				{
					"name": "entity.name.function.gamescript",
					"match": "\\b(print|printbash|printerr|printwarn|versinfo)\\b"
				},
				{
      				"name": "keyword.directive.doc.gamescript",
      				"match": "#DOC#.*$"
    			},
				{
					"name":"comment.line",
					"match": "#.*$"
				},
				{
					"name": "invalid",
					"match": "//.*$"
				}
		]
		},
		"strings": {
			"name": "string.quoted.double.gamescript",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.gamescript",
					"match": "\\\\."
				}
			]
		}
	},
	"scopeName": "source.gamescript"
}