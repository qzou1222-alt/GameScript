{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "GameScript",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
    				"name": "constant.numeric.gamescript",
    				"match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?\\b"
				},
				{
					"name": "keyword.gamescript",
					"match": "\\b(true|false|none)\\b"
				},
				{
					"name": "entity.name.function.gamescript",
					"match": "\\b(print|printbash|printerr|printwarn|versinfo|printinfo|input|is_integer)\\b"
				},
				{
      				"name": "keyword.directive.doc.gamescript",
      				"match": "#DOC#.*$"
    			},
				{
					"name":"comment.line",
					"match": "#.*$"
				},
				{
					"name": "invalid",
					"match": "//.*$"
				}
		]
		},
		"strings": {
			"name": "string.quoted.double.gamescript",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.gamescript",
					"match": "\\\\."
				}
			]
		}
	},
	"scopeName": "source.gamescript"
}
