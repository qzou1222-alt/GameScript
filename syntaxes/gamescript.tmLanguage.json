{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "GameScript",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
    				"name": "constant.numeric.gamescript",
    				"match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?\\b"
				},
				{
					"name": "keyword.gamescript",
					"match": "\\b(true|false|none)\\b"
				},
				{
					"name": "entity.name.function.gamescript",
					"match": "\\b(print|printbash|printerr|printwarn|versinfo|printinfo|input|is_integer|is_float|sum|sub|mul|div|playscript)\\b"
				},
				{
					"match": "\\b(String)\\.(join|repeat|upper|lower|contains|length)\\b",
					"captures": {
						"1": {
							"name": "entity.name.type.gamescript"
						},
						"2": {
							"name": "entity.name.function.gamescript"
						}
					}
				},

				{
					"name": "entity.name.type.gamescript",
					"match": "\\b(String)\\b|\\?"
				},
				{
					"name": "variable.gamescript",
					"match": "\\b(NaN)\\b"
				},
				{
				    "name": "variable.gamescript",
				    "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*(?::\\s*[A-Za-z_?][A-Za-z0-9_?]*)?\\s*=)"
				},
				{
				    "name": "variable.gamescript",
				    "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=(?::\\s*[A-Za-z_?][A-Za-z0-9_?]*))"
				},
				{
					"name": "invalid",
					"match": "//.*$"
				},
				{
      				"name": "keyword.directive.doc.gamescript",
      				"match": "#DOC#.*$"
    			},
				{
					"name":"comment.line.gamescript",
					"match": "#.*$"
				}
		]
		},
		"strings": {
			"name": "string.quoted.double.gamescript",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.gamescript",
					"match": "\\\\."
				}
			]
		}
	},
	"scopeName": "source.gamescript"
}
